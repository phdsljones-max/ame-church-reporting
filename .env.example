# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL=postgresql://amereports:amereports@localhost:5432/amereports

# Used by docker-compose.yml for the local Postgres container
POSTGRES_DB=amereports
POSTGRES_USER=amereports
POSTGRES_PASSWORD=amereports

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

PORT=4000
WEB_ORIGIN=http://localhost:5173

# MAILER=stub logs password-reset tokens to the server console (dev only).
# A real provider implements the Mailer interface in src/lib/mailer.ts.
MAILER=stub

# SEED=true runs the sample-data seed on server boot (dev only).
SEED=false

# Optional seed credentials. The canonical seed (server/seed/seed.ts) creates a
# SAMPLE district_admin login ONLY when these are set. Never commit real values.
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
